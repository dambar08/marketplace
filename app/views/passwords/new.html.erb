<% content_for :title, "Reset password" %>

<%= render layout: "shared/auth_frame", locals: { heading: "Reset your password", lede: "We will email reset instructions if an account exists for that address." } do %>
  <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "block text-sm font-medium text-stone-700" %>
      <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            placeholder: "you@example.com",
            value: params[:email_address],
            class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-950 shadow-sm outline-none placeholder:text-stone-400 focus:border-stone-950 focus:ring-4 focus:ring-stone-950/10" %>
    </div>

    <%= form.submit "Email reset instructions", class: "w-full cursor-pointer rounded-lg bg-stone-950 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-stone-800" %>
  <% end %>

  <p class="mt-6 text-sm text-stone-500">
    <%= link_to "Back to sign in", new_session_path, class: "underline-offset-4 hover:text-stone-950 hover:underline" %>
  </p>
<% end %>
