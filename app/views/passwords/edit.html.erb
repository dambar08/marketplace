<% content_for :title, "Choose a new password" %>

<%= render layout: "shared/auth_frame", locals: { heading: "Choose a new password", lede: "Saving a new password signs you out of every other session." } do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password,
            required: true,
            autofocus: true,
            autocomplete: "new-password",
            maxlength: 72,
            class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-950 shadow-sm outline-none focus:border-stone-950 focus:ring-4 focus:ring-stone-950/10" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            maxlength: 72,
            class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-950 shadow-sm outline-none focus:border-stone-950 focus:ring-4 focus:ring-stone-950/10" %>
    </div>

    <%= form.submit "Save password", class: "w-full cursor-pointer rounded-lg bg-stone-950 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-stone-800" %>
  <% end %>
<% end %>
