<%= form_with model: product, url: product.new_record? ? admin_products_path : admin_product_path(product), class: "mt-6 space-y-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
  <% field = "mt-2 block w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2.5 text-sm outline-none focus:border-stone-950 focus:bg-white focus:ring-4 focus:ring-stone-950/10" %>
  <div>
    <%= form.label :title, "Title", class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_field :title, required: true, class: field %>
  </div>
  <div>
    <%= form.label :subtitle, "Subtitle", class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_field :subtitle, class: field %>
  </div>
  <div>
    <%= form.label :description, "Description", class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_area :description, rows: 5, class: field %>
  </div>
  <div>
    <%= form.label :thumbnail, "Thumbnail", class: "block text-sm font-medium text-stone-700" %>
    <%= form.file_field :thumbnail, accept: "image/*", class: "mt-2 block text-sm text-stone-600" %>
  </div>
  <%= form.submit product.new_record? ? "Create product" : "Save product", class: "rounded-xl bg-stone-950 px-4 py-2.5 text-sm font-medium text-white" %>
<% end %>
