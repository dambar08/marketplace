<%= form_with model: product, url: product.new_record? ? admin_products_path : admin_product_path(product), class: "mt-6 space-y-5" do |form| %>
  <div>
    <%= form.label :title, "Title", class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_field :title, required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm" %>
  </div>
  <div>
    <%= form.label :subtitle, "Subtitle", class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_field :subtitle, class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm" %>
  </div>
  <div>
    <%= form.label :description, "Description", class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_area :description, rows: 4, class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm" %>
  </div>
  <div>
    <%= form.label :thumbnail, "Thumbnail", class: "block text-sm font-medium text-stone-700" %>
    <%= form.file_field :thumbnail, accept: "image/*", class: "mt-2 block text-sm" %>
  </div>
  <%= form.submit product.new_record? ? "Create product" : "Save product", class: "rounded-lg bg-stone-950 px-4 py-2.5 text-sm font-medium text-white" %>
<% end %>
