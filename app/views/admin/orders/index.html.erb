<% content_for :title, "Orders" %>

<div class="mx-auto max-w-5xl px-6 py-8">
  <h1 class="text-2xl font-semibold tracking-tight">Orders</h1>
  <%= render "admin/shared/toolbar", url: admin_orders_path %>
  <ul class="mt-6 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white shadow-sm">
    <% @orders.each do |order| %>
      <li class="px-5 py-3"><%= link_to "Order #{order.id}", admin_order_path(order), class: "font-medium" %></li>
    <% end %>
  </ul>
</div>
