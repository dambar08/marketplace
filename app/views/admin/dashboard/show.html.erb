<% content_for :title, "Dashboard" %>

<div class="mx-auto max-w-6xl px-6 py-8">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
      <p class="mt-1 text-sm text-stone-500">Catalog, customers, and payments at a glance.</p>
    </div>
    <p class="text-sm text-stone-500"><%= l(Time.current, format: :long) %></p>
  </header>

  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Totals">
    <%= render "admin/dashboard/stat", label: "Products", value: number_with_delimiter(@dashboard.product_count), hint: products_without_variants_hint, path: admin_products_path %>
    <%= render "admin/dashboard/stat", label: "Variants", value: number_with_delimiter(@dashboard.variant_count), path: admin_products_path %>
    <%= render "admin/dashboard/stat", label: "Orders", value: number_with_delimiter(@dashboard.order_count), path: admin_orders_path %>
    <%= render "admin/dashboard/stat", label: "Customers", value: number_with_delimiter(@dashboard.user_count), path: admin_customers_path %>
    <%= render "admin/dashboard/stat", label: "Carts", value: number_with_delimiter(@dashboard.cart_count), path: admin_carts_path %>
    <%= render "admin/dashboard/stat", label: "Promotions", value: number_with_delimiter(@dashboard.promotion_count), path: admin_promotions_path %>
    <%= render "admin/dashboard/stat", label: "Awaiting shipment", value: number_with_delimiter(@dashboard.awaiting_shipment_count), path: admin_fulfillments_path %>
    <% if @dashboard.captured_by_currency.blank? %>
      <%= render "admin/dashboard/stat", label: "Captured", value: "—", path: admin_payments_path %>
    <% else %>
      <% @dashboard.captured_by_currency.each do |currency, amount| %>
        <%= render "admin/dashboard/stat", label: "Captured", value: format_money(amount, currency), path: admin_payments_path %>
      <% end %>
    <% end %>
  </section>
  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <%= render "admin/dashboard/chart",
          name: "totals",
          heading: "Totals",
          bars: [
            { label: "Products", value: @dashboard.product_count, display: @dashboard.product_count },
            { label: "Variants", value: @dashboard.variant_count, display: @dashboard.variant_count },
            { label: "Orders", value: @dashboard.order_count, display: @dashboard.order_count },
            { label: "Customers", value: @dashboard.user_count, display: @dashboard.user_count },
            { label: "Carts", value: @dashboard.cart_count, display: @dashboard.cart_count },
            { label: "Promotions", value: @dashboard.promotion_count, display: @dashboard.promotion_count },
            { label: "Awaiting shipment", value: @dashboard.awaiting_shipment_count, display: @dashboard.awaiting_shipment_count }
          ] %>
    <%= render "admin/dashboard/chart",
          name: "captured",
          heading: "Captured",
          bars: @dashboard.captured_by_currency.map { |currency, amount|
            { label: currency, value: amount, display: number_with_precision(amount, precision: 2) }
          } %>
    <%= render "admin/dashboard/chart",
          name: "payment-status",
          heading: "Payments",
          bars: @dashboard.payment_status_counts.map { |status, count|
            { label: status.to_s.humanize, value: count, display: count }
          } %>
  </div>
  <ul class="mt-4 space-y-1">
    <% @dashboard.products_without_variants.each do |product| %>
      <li><%= link_to "#{product.title} has no variants", admin_product_path(product), class: "text-sm underline" %></li>
    <% end %>
  </ul>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="border-b border-stone-200 px-5 py-4">
        <h2 class="font-medium">Recent products</h2>
      </div>
      <% if @dashboard.recent_products.any? %>
        <ul class="divide-y divide-stone-100">
          <% @dashboard.recent_products.each do |product| %>
            <li class="flex items-center justify-between gap-4 px-5 py-3">
              <div class="min-w-0">
                <p class="truncate font-medium"><%= link_to product.title, admin_product_path(product) %></p>
                <p class="text-sm text-stone-500"><%= pluralize(product.variants.size, "variant") %></p>
              </div>
              <p class="shrink-0 text-sm text-stone-400"><%= time_ago_in_words(product.created_at) %> ago</p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-8 text-sm text-stone-500">No products yet.</p>
      <% end %>
    </section>

    <section class="rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="border-b border-stone-200 px-5 py-4">
        <h2 class="font-medium">Payments</h2>
      </div>
      <% if @dashboard.payment_status_counts.any? %>
        <ul class="divide-y divide-stone-100">
          <% @dashboard.payment_status_counts.each do |status, count| %>
            <li class="flex items-center justify-between px-5 py-3">
              <p class="font-medium capitalize"><%= status.to_s.humanize %></p>
              <p class="text-sm text-stone-500"><%= pluralize(count, "collection") %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-8 text-sm text-stone-500">No payment collections yet.</p>
      <% end %>
      <% if @dashboard.recent_payments.any? %>
        <div class="border-t border-stone-200">
          <ul class="divide-y divide-stone-100">
            <% @dashboard.recent_payments.each do |payment| %>
              <li class="flex items-center justify-between gap-4 px-5 py-3 text-sm">
                <p class="font-medium"><%= format_money(payment.amount, payment.currency_code) %></p>
                <p class="text-stone-500"><%= payment.status.to_s.humanize %></p>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="border-b border-stone-200 px-5 py-4">
        <h2 class="font-medium">Low stock</h2>
      </div>
      <% if @dashboard.low_stock_variants.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="text-stone-500">
              <tr>
                <th class="px-5 py-2 font-medium">Variant</th>
                <th class="px-5 py-2 font-medium">Product</th>
                <th class="px-5 py-2 text-right font-medium">Qty</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              <% @dashboard.low_stock_variants.each do |variant| %>
                <tr>
                  <td class="px-5 py-3 font-medium"><%= link_to variant.title, admin_product_path(variant.product, anchor: "variant-#{variant.id}") %></td>
                  <td class="px-5 py-3 text-stone-500"><%= link_to variant.product.title, admin_product_path(variant.product) %></td>
                  <td class="px-5 py-3 text-right <%= variant.inventory_quantity.to_i.zero? ? "text-red-700" : "text-amber-700" %>"><%= variant.inventory_quantity %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="px-5 py-8 text-sm text-stone-500">No variants at or below <%= Admin::Dashboard::LOW_STOCK_THRESHOLD %> in stock.</p>
      <% end %>
    </section>

    <section class="rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="border-b border-stone-200 px-5 py-4">
        <h2 class="font-medium">Recent customers</h2>
      </div>
      <% if @dashboard.recent_users.any? %>
        <ul class="divide-y divide-stone-100">
          <% @dashboard.recent_users.each do |user| %>
            <li class="flex items-center justify-between gap-4 px-5 py-3">
              <div class="min-w-0">
                <p class="truncate font-medium"><%= user.email_address %></p>
                <p class="text-sm text-stone-500"><%= user.admin? ? "Admin" : "Customer" %></p>
              </div>
              <p class="shrink-0 text-sm text-stone-400"><%= time_ago_in_words(user.created_at) %> ago</p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-8 text-sm text-stone-500">No customers yet.</p>
      <% end %>
    </section>
  </div>
</div>
