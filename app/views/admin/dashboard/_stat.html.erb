<% stat = capture do %>
  <div class="rounded-xl border border-stone-200 bg-white px-5 py-4">
    <p class="text-sm font-medium text-stone-500"><%= label %></p>
    <p class="mt-2 text-2xl font-semibold tracking-tight text-stone-950"><%= value %></p>
    <% if local_assigns[:hint].present? %>
      <p class="mt-1 text-xs text-stone-400"><%= hint %></p>
    <% end %>
  </div>
<% end %>
<% if local_assigns[:path].present? %>
  <%= link_to path, class: "block rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-950" do %>
    <%= stat %>
  <% end %>
<% else %>
  <%= stat %>
<% end %>
