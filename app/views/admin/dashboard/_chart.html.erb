<% max = bars.map { |bar| bar[:value].to_f }.max.to_f %>
<section data-chart="<%= name %>" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" aria-label="<%= heading %>">
  <h2 class="text-sm font-medium text-stone-500"><%= heading %></h2>
  <ul class="mt-4 space-y-3">
    <% bars.each do |bar| %>
      <% width = max.zero? ? 0 : (bar[:value].to_f / max * 100).round %>
      <li data-label="<%= bar[:label] %>" data-value="<%= bar[:display] %>">
        <div class="flex items-baseline justify-between gap-3 text-sm">
          <span class="font-medium text-stone-800"><%= bar[:label] %></span>
          <span class="tabular-nums text-stone-500"><%= bar[:display] %></span>
        </div>
        <span class="chart-bar mt-1 block h-2 rounded-full bg-stone-950" style="width: <%= width %>%"></span>
      </li>
    <% end %>
  </ul>
</section>
