<% content_for :title, "Payments" %>

<div class="mx-auto max-w-5xl px-6 py-8">
  <h1 class="text-2xl font-semibold tracking-tight">Payments</h1>
  <ul class="mt-6 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
    <% @payments.each do |payment| %>
      <li class="px-5 py-3">
        <%= link_to format_money(payment.amount, payment.currency_code), admin_payment_path(payment), class: "font-medium" %>
        <p class="text-sm text-stone-500"><%= payment.status.to_s.humanize %></p>
      </li>
    <% end %>
  </ul>
</div>
