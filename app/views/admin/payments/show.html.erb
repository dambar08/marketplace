<% content_for :title, "Payment" %>

<div class="mx-auto max-w-3xl px-6 py-8">
  <h1 class="text-2xl font-semibold tracking-tight">Payment</h1>
  <dl class="mt-6 space-y-2 text-sm">
    <div><dt class="inline text-stone-500">Amount</dt> <dd class="inline"><%= format_money(@payment.amount, @payment.currency_code) %></dd></div>
    <div><dt class="inline text-stone-500">Authorized</dt> <dd class="inline"><%= format_money(@payment.authorized_amount, @payment.currency_code) %></dd></div>
    <div><dt class="inline text-stone-500">Captured</dt> <dd class="inline"><%= format_money(@payment.captured_amount, @payment.currency_code) %></dd></div>
    <div><dt class="inline text-stone-500">Refunded</dt> <dd class="inline"><%= format_money(@payment.refunded_amount, @payment.currency_code) %></dd></div>
    <div><dt class="inline text-stone-500">Status</dt> <dd class="inline"><%= @payment.status.to_s.humanize %></dd></div>
  </dl>
</div>
