<%= form_with model: [:admin, promotion], class: "mt-6 space-y-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
  <div>
    <%= form.label :code, "Code", class: "block text-sm font-medium" %>
    <%= form.text_field :code, required: true, class: "mt-2 #{admin_field_class}" %>
  </div>
  <div>
    <%= form.label :value, "Value", class: "block text-sm font-medium" %>
    <%= form.number_field :value, step: "0.01", required: true, class: "mt-2 #{admin_field_class}" %>
  </div>
  <%= form.submit promotion.new_record? ? "Create promotion" : "Save promotion", class: admin_button_class %>
<% end %>
