<% content_for :title, @promotion.code %>

<div class="mx-auto max-w-3xl px-6 py-8">
  <h1 class="text-2xl font-semibold tracking-tight"><%= @promotion.code %></h1>
  <p class="mt-2 text-sm"><%= number_with_precision(@promotion.value, precision: 2) %></p>
  <%= link_to "Edit", edit_admin_promotion_path(@promotion), class: "mt-4 inline-block text-sm underline" %>
  <%= button_to "Remove promotion", admin_promotion_path(@promotion), method: :delete, class: "mt-2 text-sm text-red-700" %>
</div>
