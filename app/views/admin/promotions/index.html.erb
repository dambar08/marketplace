<% content_for :title, "Promotions" %>

<div class="mx-auto max-w-5xl px-6 py-8">
  <div class="flex items-end justify-between">
    <h1 class="text-2xl font-semibold tracking-tight">Promotions</h1>
    <%= link_to "New promotion", new_admin_promotion_path, class: "text-sm underline" %>
  </div>
  <ul class="mt-6 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
    <% @promotions.each do |promotion| %>
      <li class="px-5 py-3"><%= link_to promotion.code, admin_promotion_path(promotion), class: "font-medium" %></li>
    <% end %>
  </ul>
</div>
