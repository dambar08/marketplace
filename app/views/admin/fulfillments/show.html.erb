<% content_for :title, "Fulfillment #{@fulfillment.id}" %>

<div class="mx-auto max-w-3xl px-6 py-8">
  <h1 class="text-2xl font-semibold tracking-tight">Fulfillment <%= @fulfillment.id %></h1>
  <p class="mt-2 text-sm text-stone-500"><%= @fulfillment.status_label %></p>
  <% if @fulfillment.errors[:tracking_number].any? %>
    <p class="mt-3 text-sm text-red-700">Tracking is required to mark shipped</p>
  <% end %>
  <% if @fulfillment.tracking_numbers.any? %>
    <p class="mt-3 text-sm">Tracking <%= @fulfillment.tracking_numbers.join(", ") %></p>
  <% end %>

  <h2 class="mt-8 font-medium">Lines</h2>
  <% if @fulfillment.fulfillment_items.none? %>
    <p class="mt-2 text-sm text-stone-500">No lines</p>
  <% else %>
    <ul class="mt-2 space-y-1">
      <% @fulfillment.fulfillment_items.each do |item| %>
        <li class="text-sm"><%= item.line_item.title %> Qty <%= item.quantity %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: admin_fulfillment_path(@fulfillment), method: :patch, class: "mt-8 space-y-3" do |form| %>
    <%= form.label :status, "Status", class: "block text-sm font-medium" %>
    <%= form.select :status, [ [ "Packed", "packed" ], [ "Shipped", "shipped" ], [ "Delivered", "delivered" ], [ "Cancelled", "cancelled" ] ], {}, class: "rounded-lg border border-stone-300 px-3 py-2 text-sm" %>
    <%= form.label :tracking_number, "Tracking", class: "block text-sm font-medium" %>
    <%= form.text_field :tracking_number, class: "rounded-lg border border-stone-300 px-3 py-2 text-sm" %>
    <%= form.submit "Record status", class: "rounded-lg bg-stone-950 px-3 py-2 text-sm text-white" %>
  <% end %>
</div>
