<% content_for :title, "Awaiting shipment" %>

<div class="mx-auto max-w-5xl px-6 py-8">
  <h1 class="text-2xl font-semibold tracking-tight">Awaiting shipment</h1>
  <%= render "admin/shared/toolbar", url: admin_fulfillments_path, filters: [ [ "Awaiting shipment", admin_fulfillments_path ] ] %>
  <ul class="mt-6 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white shadow-sm">
    <% @fulfillments.each do |fulfillment| %>
      <li class="px-5 py-3">
        <%= link_to "Fulfillment #{fulfillment.id}", admin_fulfillment_path(fulfillment), class: "font-medium" %>
        <p class="text-sm text-stone-500"><%= fulfillment.status_label %></p>
      </li>
    <% end %>
  </ul>
</div>
