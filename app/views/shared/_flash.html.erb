<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% palette = case type.to_s
       when "notice" then "border-emerald-200 bg-emerald-50 text-emerald-950"
       when "alert" then "border-red-200 bg-red-50 text-red-950"
       else "border-stone-200 bg-white text-stone-950"
       end %>
  <div role="<%= type.to_s == "alert" ? "alert" : "status" %>"
       class="mx-4 mt-4 flex items-start justify-between gap-4 rounded-lg border px-4 py-3 text-sm shadow-sm <%= palette %>"
       data-controller="dismiss"
       data-dismiss-delay-value="6000"
       data-turbo-temporary>
    <p class="min-w-0 flex-1"><%= message %></p>
    <button type="button" class="-m-1 shrink-0 px-1 text-lg leading-none opacity-60 hover:opacity-100" data-action="dismiss#remove" aria-label="Dismiss">&times;</button>
  </div>
<% end %>
