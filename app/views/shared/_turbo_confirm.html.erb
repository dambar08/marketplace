<dialog id="turbo-confirm" data-turbo-permanent class="m-auto w-[min(100%-2rem,28rem)] rounded-lg border border-stone-200 bg-white p-0 text-stone-950 shadow-xl backdrop:bg-stone-950/40">
  <form method="dialog" class="p-6">
    <p id="turbo-confirm-message" data-turbo-confirm-message class="text-sm leading-6"></p>
    <div class="mt-6 flex justify-end gap-2">
      <button value="cancel" class="rounded-md border border-stone-300 px-3 py-1.5 text-sm">Cancel</button>
      <button value="confirm" class="rounded-md bg-stone-950 px-3 py-1.5 text-sm text-white">Confirm</button>
    </div>
  </form>
</dialog>
