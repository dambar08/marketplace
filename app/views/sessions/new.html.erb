<% content_for :title, "Sign in" %>

<%= render layout: "shared/auth_frame", locals: { heading: "Sign in", lede: "Use the email and password on your staff account." } do %>
  <%= form_with url: session_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "block text-sm font-medium text-stone-700" %>
      <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            placeholder: "you@example.com",
            value: params[:email_address],
            class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-950 shadow-sm outline-none placeholder:text-stone-400 focus:border-stone-950 focus:ring-4 focus:ring-stone-950/10" %>
    </div>

    <div>
      <div class="flex items-center justify-between gap-3">
        <%= form.label :password, "Password", class: "block text-sm font-medium text-stone-700" %>
        <%= link_to "Forgot password?", new_password_path, class: "text-sm text-stone-500 underline-offset-4 hover:text-stone-950 hover:underline" %>
      </div>
      <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            maxlength: 72,
            class: "mt-2 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-950 shadow-sm outline-none placeholder:text-stone-400 focus:border-stone-950 focus:ring-4 focus:ring-stone-950/10" %>
    </div>

    <%= form.submit "Sign in", class: "w-full cursor-pointer rounded-lg bg-stone-950 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-stone-800" %>
  <% end %>
<% end %>
